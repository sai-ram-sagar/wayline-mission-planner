# Copy to .env to override. All values have working defaults.

# Where the browser sends API calls. Leave as /api to use the Vite dev proxy
# (see vite.config.js); set an absolute URL when the frontend is served
# separately from the API in production.
VITE_API_BASE_URL=/api

# Target the dev proxy forwards /api to.
VITE_API_PROXY_TARGET=http://localhost:4000

# Initial map centre and zoom for a brand-new mission.
VITE_DEFAULT_MAP_LAT=-37.8050
VITE_DEFAULT_MAP_LNG=145.2780
VITE_DEFAULT_MAP_ZOOM=16
