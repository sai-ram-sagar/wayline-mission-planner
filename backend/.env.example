# Copy to .env and adjust as needed. Every value below is also the built-in
# default, so the server runs correctly with no .env file at all.

# Port the API listens on.
PORT=4000

# SQLite file location, relative to the backend/ directory.
# The file and its parent directory are created on first run and seeded.
DB_PATH=data/wayline.sqlite

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server defaults to 5173.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Set to "false" to skip inserting the mock drone fleet on first run.
SEED_DRONES=true
